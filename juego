                "Dale un beso de mariposa (con las pestañas) en el cuello a alguien de la sala.",
                "Describe el mejor encuentro íntimo que has tenido en tu vida.",
                "Susúrrale algo sucio al oído a la persona de la izquierda",
                "¿Qué parte del cuerpo de la persona a tu derecha te crees que es más sexy?",
                "Simula tu posición sexual favorita durante 10 segundos (con ropa).",
                "¿Cuál es el lugar más extraño donde has tenido relaciones?",
                "Deja que alguien del grupo te dé un beso apasionado en el cuello.",
                "¿Alguna vez has tenido un trío o estarías dispuesto/a?",
                "Quítate los calcetines usando solo la boca.",
                "Susúrrale algo sucio al oído a la persona de la derecha",
                "¿Cuál es tu lugar favorito para tener una aventura?",
                "¿Qué prenda de ropa te quitarías ahora mismo?",
                "¿Qué es lo más loco que has hecho en la cama?",
                "¿Besarías a la persona que tienes enfrente?",
                "¿Cuál es tu fantasía sexual nunca cumplida?",
                "Describe el mejor encuentro íntimo que has tenido.",
                "Susúrrale algo sucio al oído a la persona que elijas.",
                "¿Qué parte del cuerpo de la persona a tu derecha es más sexy?",
                "Simula tu posición favorita durante 10 segundos (con ropa)."
            ]
        };

        // ESTADO DEL JUEGO
        let jugadores = [];
        let turnoActual = 0;
        let puntosEnJuego = 0;

        // FUNCIONES DE NAVEGACIÓN
        function showScreen(id) {
            document.getElementById('screen-setup').classList.add('hidden');
            document.getElementById('screen-menu').classList.add('hidden');
            document.getElementById('screen-game').classList.add('hidden');
            document.getElementById('screen-final').classList.add('hidden');
            document.getElementById(id).classList.remove('hidden');
            
            if (id !== 'screen-setup' && id !== 'screen-final') {
                document.getElementById('game-header').classList.remove('hidden');
            } else {
                document.getElementById('game-header').classList.add('hidden');
            }
        }

        function addInput() {
            const container = document.getElementById('players-input-container');
            const num = container.querySelectorAll('input').length + 1;
            const input = document.createElement('input');
            input.type = 'text';
            input.placeholder = `Nombre del Jugador ${num}`;
            input.className = 'player-input w-full bg-white/5 border border-white/10 p-4 rounded-2xl text-center focus:outline-none focus:ring-2 focus:ring-pink-500 transition-all';
            container.appendChild(input);
        }

        function startGame() {
            const inputs = document.querySelectorAll('.player-input');
            jugadores = [];
            inputs.forEach(input => {
                const name = input.value.trim();
                if (name) jugadores.push({ nombre: name, puntos: 0 });
            });

            if (jugadores.length < 2) {
                alert("Se necesitan al menos 2 pecadores para jugar.");
                return;
            }

            updateUI();
            showScreen('screen-menu');
        }

        function updateUI() {
            const actual = jugadores[turnoActual];
            document.getElementById('display-current-player').textContent = actual.nombre;
            document.getElementById('menu-player-name').textContent = actual.nombre;
            document.getElementById('display-score').textContent = actual.puntos;
        }

        function selectCategory(cat, pts) {
            puntosEnJuego = pts;
            const lista = PREGUNTAS[cat];
            const pregunta = lista[Math.floor(Math.random() * lista.length)];

            document.getElementById('game-cat-display').textContent = `${cat} (+${pts} PTS)`;
            document.getElementById('game-question-text').textContent = pregunta;
            showScreen('screen-game');
        }

        function finishTurn(cumplido) {
            if (cumplido) {
                jugadores[turnoActual].puntos += puntosEnJuego;
            }

            turnoActual++;

            if (turnoActual >= jugadores.length) {
                if (confirm("¿Quieren ver los resultados finales o seguir otra ronda?")) {
                    showFinal();
                } else {
                    turnoActual = 0;
                    updateUI();
                    showScreen('screen-menu');
                }
            } else {
                updateUI();
                showScreen('screen-menu');
            }
        }

        function showFinal() {
            const board = document.getElementById('leaderboard');
            const sorted = [...jugadores].sort((a, b) => b.puntos - a.puntos);
            
            board.innerHTML = sorted.map((p, i) => `
                <div class="flex justify-between items-center p-4 ${i === 0 ? 'bg-pink-500/20 border-pink-500' : 'bg-white/5 border-white/10'} border rounded-2xl">
                    <div class="flex items-center gap-3">
                        <span class="text-xl">${i === 0 ? '👑' : i + 1}</span>
                        <span class="font-bold">${p.nombre}</span>
                    </div>
                    <span class="font-black text-pink-400">${p.puntos} pts</span>
                </div>
            `).join('');

            showScreen('screen-final');
        }
    </script>
</body>
</html>
