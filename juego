<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NINGUNA SANTA 🔥 FINAL</title>
    <!-- Tailwind CSS para diseño moderno -->
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700&family=Poppins:wght@300;400;700&display=swap');
        
        body {
            font-family: 'Poppins', sans-serif;
            background: #0a0a0a;
            color: white;
            overflow-x: hidden;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 1rem;
        }

        .neo-gradient {
            background: linear-gradient(45deg, #0f0c29, #302b63, #24243e);
            position: fixed;
            inset: 0;
            z-index: -1;
        }

        .glass {
            background: rgba(255, 255, 255, 0.05);
            backdrop-filter: blur(15px);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .neon-text-pink { text-shadow: 0 0 10px #ff4d94, 0 0 20px #ff4d94; }
        
        .btn-primary {
            background: linear-gradient(90deg, #ff4d94, #bc84ee);
            transition: all 0.3s ease;
        }
        .btn-primary:hover:not(:disabled) {
            transform: translateY(-2px);
            box-shadow: 0 5px 20px rgba(255, 77, 148, 0.5);
        }

        .category-card {
            transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            cursor: pointer;
        }
        .category-card:hover {
            transform: scale(1.05);
            background: rgba(255, 255, 255, 0.1);
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }
        .animate-screen { animation: fadeIn 0.4s ease-out forwards; }
    </style>
</head>
<body>
    <div class="neo-gradient"></div>

    <div id="app" class="w-full max-w-md glass rounded-[2.5rem] p-8 shadow-2xl relative overflow-hidden">
        
        <!-- HEADER (Visible durante el juego) -->
        <div id="game-header" class="hidden mb-6 border-b border-white/10 pb-4 flex justify-between items-end">
            <div>
                <p class="text-[10px] uppercase tracking-[0.2em] text-pink-400 font-bold">Turno de:</p>
                <h2 id="display-current-player" class="text-xl font-bold truncate max-w-[150px]">-</h2>
            </div>
            <div class="text-right">
                <div class="flex items-center gap-2">
                    <span class="text-lg font-black text-yellow-400">⭐ <span id="display-score">0</span></span>
                </div>
            </div>
        </div>

        <!-- PANTALLA 1: REGISTRO DE JUGADORES -->
        <div id="screen-setup" class="animate-screen space-y-6">
            <div class="text-center">
                <h1 class="text-5xl font-black neon-text-pink mb-2 tracking-tighter italic">NINGUNA SANTA</h1>
                <p class="text-white/60 text-xs italic uppercase tracking-[0.3em]">Edición Local 🔥</p>
            </div>

            <div id="players-input-container" class="space-y-3">
                <input type="text" placeholder="Nombre del Jugador 1" class="player-input w-full bg-white/5 border border-white/10 p-4 rounded-2xl text-center focus:outline-none focus:ring-2 focus:ring-pink-500 transition-all">
                <input type="text" placeholder="Nombre del Jugador 2" class="player-input w-full bg-white/5 border border-white/10 p-4 rounded-2xl text-center focus:outline-none focus:ring-2 focus:ring-pink-500 transition-all">
            </div>

            <button onclick="addInput()" class="w-full py-2 text-pink-400 text-xs font-bold uppercase tracking-widest">+ Añadir más amigos</button>
            <button onclick="startGame()" class="btn-primary w-full p-4 rounded-2xl font-bold text-white uppercase tracking-widest shadow-lg">Comenzar Pecado</button>
        </div>

        <!-- PANTALLA 2: MENÚ DE CATEGORÍAS -->
        <div id="screen-menu" class="hidden animate-screen">
            <div class="text-center mb-6">
                <p class="text-[10px] text-white/40 uppercase tracking-widest">Es el momento de...</p>
                <h3 id="menu-player-name" class="text-2xl font-black text-pink-500 uppercase italic">-</h3>
            </div>
            <div class="grid grid-cols-2 gap-4">
                <div onclick="selectCategory('Random', 50)" class="category-card p-5 rounded-[2rem] glass flex flex-col items-center">
                    <span class="text-3xl mb-1">🎲</span>
                    <span class="font-bold text-[10px] uppercase">Random</span>
                    <span class="text-[8px] opacity-40">50 PTS</span>
                </div>
                <div onclick="selectCategory('Verdades', 100)" class="category-card p-5 rounded-[2rem] glass flex flex-col items-center">
                    <span class="text-3xl mb-1">💡</span>
                    <span class="font-bold text-[10px] uppercase">Verdades</span>
                    <span class="text-[8px] opacity-40">100 PTS</span>
                </div>
                <div onclick="selectCategory('Atrevido', 150)" class="category-card p-5 rounded-[2rem] glass flex flex-col items-center">
                    <span class="text-3xl mb-1">📢</span>
                    <span class="font-bold text-[10px] uppercase">Atrevido</span>
                    <span class="text-[8px] opacity-40">150 PTS</span>
                </div>
                <div onclick="selectCategory('Candente', 250)" class="category-card p-5 rounded-[2rem] glass flex flex-col items-center">
                    <span class="text-3xl mb-1">🌶️</span>
                    <span class="font-bold text-[10px] uppercase">Candente</span>
                    <span class="text-[8px] opacity-40">250 PTS</span>
                </div>
            </div>
        </div>

        <!-- PANTALLA 3: EL RETO -->
        <div id="screen-game" class="hidden animate-screen space-y-8 text-center">
            <div class="inline-block px-4 py-1 bg-pink-500/10 border border-pink-500/40 rounded-full">
                <span id="game-cat-display" class="text-[10px] font-black text-pink-400 uppercase tracking-widest">-</span>
            </div>

            <div class="min-h-[160px] flex items-center justify-center">
                <p id="game-question-text" class="text-xl font-medium leading-relaxed italic text-white px-2"></p>
            </div>

            <div class="space-y-4">
                <button onclick="finishTurn(true)" class="btn-primary w-full p-4 rounded-2xl font-black text-lg uppercase shadow-xl">¡Cumplido! 🔥</button>
                <button onclick="finishTurn(false)" class="w-full text-white/40 text-xs py-2 uppercase tracking-widest font-bold hover:text-white transition-colors">Cobardía (Pasar)</button>
            </div>
        </div>

        <!-- PANTALLA 4: RESULTADOS FINALES -->
        <div id="screen-final" class="hidden animate-screen text-center space-y-6">
            <h2 class="text-3xl font-black neon-text-pink italic">FIN DEL JUEGO</h2>
            <div id="leaderboard" class="space-y-3">
                <!-- Se llena dinámicamente -->
            </div>
            <button onclick="location.reload()" class="btn-primary w-full p-4 rounded-2xl font-bold text-white uppercase tracking-widest">Reiniciar</button>
        </div>
    </div>

    <script>
        // BASE DE DATOS LOCAL
